[Unit]
Description=Karaoke AI DJ MCP server (SSE + Streamable HTTP on :8888)
Documentation=file:///home/tina/karaoke/docs/mcp-server.md
After=network-online.target
Wants=network-online.target
PartOf=karaoke.target

[Service]
Type=simple
WorkingDirectory=/home/tina/karaoke
Environment=PYTHONPATH=/home/tina/karaoke/src
ExecStart=/home/tina/karaoke/.venv/bin/python -m karaoke.mcp_server --host 0.0.0.0 --port 8888
Restart=on-failure
RestartSec=3
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do curl -fsS -I http://127.0.0.1:8888/sse >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
SyslogIdentifier=karaoke-mcp

[Install]
WantedBy=karaoke.target
